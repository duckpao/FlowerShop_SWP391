@startuml
title Password Recovery - sequence diagram
autonumber
skinparam shadowing false
skinparam defaultFontName Arial
skinparam wrapWidth 240
skinparam ArrowColor #444444
skinparam sequenceMessageAlign left
skinparam sequence {
  LifeLineBorderColor #888888
  ParticipantBorderColor #444444
  ParticipantBackgroundColor #FFFFFF
}

actor User
participant "View" as V <<View>> #EADCFF
participant AuthController as C <<Controller>> #D8F3DC
participant OtpService as OS <<Service>> #DCECFF
participant CaptchaService as CAP <<Service>> #DCECFF
participant UserRepository as UR <<Repository>> #FFF1C9
participant OtpChallengeRepository as OCR <<Repository>> #FFF1C9
participant AuthSessionRepository as SESS <<Repository>> #FFF1C9
participant "ApplicationEventPublisher" as EVT <<Service>> #DCECFF
participant VerificationMailSender as MAIL <<Service>> #DCECFF
database Database

== Request reset code ==
User -> V : enter email on "forgot password" page
V -> C : POST /api/auth/forgot-password (X-CSRF-TOKEN header)
C -> OS : forgotPassword(email, captchaId, captchaAnswer)
OS -> UR : findUserIdByEmail(normalized email)
alt unknown email
  OS --> C : return, nothing stored, nothing sent
else user found
  OS -> UR : findByIdForUpdate(userId)
  OS -> OS : eligible(): status ACTIVE, email verified, has password hash
  alt not eligible
    OS --> C : return, nothing stored, nothing sent
  else eligible
    OS -> OCR : findLocked(userId, RESET_PASSWORD), or create a new challenge
    opt failedAttempts >= 6
      OS -> CAP : verify(email, "reset", captchaId, captchaAnswer)
      CAP --> OS : CaptchaRequiredException (429, captchaRequired = true) if missing or wrong
    end
    OS -> OS : new 15 min window if the old one has expired (sendCount reset to 0)
    OS -> OS : new 6-digit code, stored as BCrypt hash of userId:purpose:code, expires in 300 s
    OS -> OCR : save(challenge) with sendCount + 1
    OS -> EVT : publish AuthMailEvent(RESET_OTP, code)
    EVT -> MAIL : BEFORE_COMMIT sendOtp(event)
    MAIL --> User : reset code email (SMTP failure gives 503 and the transaction rolls back)
    OS --> C : return
  end
end
C --> V : 202 Accepted "Nếu tài khoản đủ điều kiện, mã đặt lại mật khẩu sẽ được gửi qua email."
V --> User : show code entry step

== Resend code (same endpoint) ==
User -> V : click resend
V -> C : POST /api/auth/forgot-password again
C -> OS : forgotPassword(email, captchaId, captchaAnswer)
note right of OS
  No separate resend endpoint.
  issue() finds the same challenge (userId + RESET_PASSWORD)
  and overwrites its code hash and expiry, so the previous code stops working.
  Failed-attempt counter is kept.
end note
OS -> OCR : save(challenge) with the new hash
OS -> EVT : publish AuthMailEvent(RESET_OTP, new code)
EVT -> MAIL : BEFORE_COMMIT sendOtp(event)
MAIL --> User : new reset code email

== Reset password ==
User -> V : enter code, new password, confirmation
V -> C : POST /api/auth/reset-password
C -> OS : resetPassword(email, otp, newPassword, confirmPassword, captchaId, captchaAnswer)
alt confirmation does not match
  OS --> C : 400 "Mật khẩu xác nhận không khớp."
else length under 15 characters, or over 72 UTF-8 bytes
  OS --> C : 400 "Mật khẩu tối thiểu 15 ký tự và tối đa 72 byte UTF-8."
else lengths valid
  OS -> UR : findUserIdByEmail, then findByIdForUpdate
  alt unknown email
    OS --> C : 400 InvalidOtpException
  else user found
    OS -> OS : consume(): eligible() must hold, else 400 InvalidOtpException
    OS -> OCR : findLocked(userId, RESET_PASSWORD)
    opt failedAttempts >= 6
      OS -> CAP : verify(email, "reset", captchaId, captchaAnswer)
      CAP --> OS : CaptchaRequiredException (429) if missing or wrong
    end
    alt challenge used, or expired
      OS --> C : 400 InvalidOtpException
    else code does not match
      OS -> OS : failedAttempts = min(6, failedAttempts + 1)
      alt failedAttempts reached 6
        OS --> C : 429 CaptchaRequiredException (captchaRequired = true)
      else
        OS --> C : 400 InvalidOtpException
      end
    else code matches
      OS -> OCR : usedAt = now (code can be used once)
      OS -> UR : setPasswordHash(BCrypt(newPassword))
      OS -> SESS : revokeAll(userId)
      OS -> EVT : publish AuthMailEvent(PASSWORD_CHANGED)
      EVT -> MAIL : AFTER_COMMIT send(event)
      MAIL --> User : password changed notice
      OS --> C : return
      C --> V : 200 "Đặt lại mật khẩu thành công."
      V --> User : clear session, go to sign in
    end
  end
end
note over OS
  resetPassword() uses noRollbackFor InvalidOtpException,
  so wrong-code counters are saved.
end note

@enduml
