@startuml
title 3.9 Order Management - class diagram
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam wrapWidth 240
skinparam ArrowColor #444444
skinparam classAttributeIconSize 0
skinparam nodesep 45
skinparam ranksep 50
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #444444
  BackgroundColor<<View>> #EADCFF
  BackgroundColor<<Controller>> #D8F3DC
  BackgroundColor<<Service>> #DCECFF
  BackgroundColor<<Repository>> #FFF1C9
  BackgroundColor<<Entity>> #E0F3E7
  BackgroundColor<<DTO>> #FCE7F3
  BackgroundColor<<Scheduler>> #FFE8CC
  BackgroundColor<<External>> #FFE0E0
}
hide empty members
hide circle

class View <<View>>

class ManagerOrderController <<Controller>> {
  list(shopId, user, page, status)
  detail(shopId, id, user)
  cancel(shopId, id, user, body)
  updateGhn(shopId, id, user, body)
}
class ManagerOrderService <<Service>> {
  list(shopId, actor, page, status): Results
  detail(shopId, actor, orderId): OrderDetailResponse
  cancel(shopId, actor, orderId, reason)
  updateGhn(shopId, actor, orderId, body)
  -owned(shopId, actor): Shop
}
class GhnService <<Service>> {
  updateOrder(orderCode, updateFields)
  switchStatus(orderCode, action)
}
class OrderService <<Service>> {
  makeOrders(userId, request)
}
class OrderRepository <<Repository>> {
  findByShopId(shopId, pageable)
  findByShopIdAndStatus(shopId, status, pageable)
  findByIdAndShopId(id, shopId)
  findByIdAndShopIdForUpdate(id, shopId)
}
class DeliveryRepository <<Repository>> {
  findByOrderId(orderId)
}
class PaymentRepository <<Repository>> {
  failPendingByOrderId(orderId, actor)
}
interface RefundRepository <<Repository>>
class Order <<Entity>> {
  id
  totalAmount
  status
  cancelReason
  createdDate
}
class Delivery <<Entity>> {
  trackingCode
  ghnStatus
}
class Refund <<Entity>> {
  amount
  reason
  status
}
class Shop <<Entity>>
class User <<Entity>> {
  fullName
  phone
}
enum OrderStatus <<Entity>> {
  PENDING
  AWAITING_DEPOSIT
  DEPOSIT_PAID
  PROCESSING
  DELIVERING
  COMPLETED
  CANCELLED
  REFUNDED
  AWAITING_QUOTE
  QUOTED
}

View ..> ManagerOrderController : GET /api/shop/mine/{shopId}/orders
View ..> ManagerOrderController : GET /api/shop/mine/{shopId}/orders/{id}
View ..> ManagerOrderController : POST /api/shop/mine/{shopId}/orders/{id}/cancel
View ..> ManagerOrderController : POST /api/shop/mine/{shopId}/orders/{id}/update-ghn
ManagerOrderController --> ManagerOrderService
ManagerOrderService --> OrderRepository
ManagerOrderService --> DeliveryRepository
ManagerOrderService --> PaymentRepository
ManagerOrderService --> RefundRepository
ManagerOrderService --> GhnService
OrderService ..> OrderRepository : creates new orders (customer checkout)
OrderRepository ..> Order
DeliveryRepository ..> Delivery
RefundRepository ..> Refund
Order "*" --> "1" Shop
Order "*" --> "1" User : customer
Order --> OrderStatus
Delivery "0..1" --> "1" Order
Refund "*" --> "1" Order

@enduml
