        enum status "ACTIVE, INACTIVE, BANNED"
        timestamp created_date
        nvarchar created_by "36"
        timestamp last_modify_date
        nvarchar last_modify_by "36"
    }

    Shops {
        nvarchar id PK "36"
        nvarchar owner_id FK,UK "36"
        nvarchar name "255"
        text description
        nvarchar logo_url "255"
