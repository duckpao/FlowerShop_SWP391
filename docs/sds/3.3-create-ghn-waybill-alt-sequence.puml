@startuml
title 3.3 Assign Order to Delivery (alternative view) - sequence diagram
autonumber
skinparam shadowing false
skinparam defaultFontName Arial
skinparam wrapWidth 240
skinparam ArrowColor #444444
skinparam sequenceMessageAlign left
skinparam sequence {
  LifeLineBorderColor #888888
  ParticipantBorderColor #444444
  ParticipantBackgroundColor #FFFFFF
}

actor "Shop Manager / Staff" as M
participant "View" as V <<View>> #EADCFF
participant ManagerOrderController as C <<Controller>> #D8F3DC
participant ManagerOrderService as S <<Service>> #DCECFF
participant GhnService as G <<Service>> #DCECFF
participant DeliverySync as DS <<Service>> #DCECFF
participant "GHN API" as API <<External>> #FFE0E0
database MySQL

== Create waybill (ship) ==
M -> V : click Ship, confirm "Tạo vận đơn GHN"
V -> C : POST /api/shop/mine/{shopId}/orders/{id}/ship
C -> S : ship(shopId, actor, orderId)
S -> S : owned(shopId, actor)
S -> MySQL : load Order (FOR UPDATE)
alt status is not PROCESSING or DEPOSIT_PAID
  S --> C : 400 Chỉ đơn hàng PROCESSING hoặc đã đặt cọc mới có thể gửi GHN.
else Delivery already exists
  S --> C : 409 Đơn đã có vận đơn.
else
  S -> MySQL : shop default pickup Address (user is null)
  alt shop has no address
    S --> C : 400 Shop chưa cấu hình địa chỉ.
  else recipient has no address, or phone missing
    S --> C : 400 (Đơn hàng chưa có địa chỉ nhận / SĐT trống)
  else valid
    S -> S : codAmount = total - SUCCESS payments
    opt codAmount > 0 and no COD payment yet
      S -> MySQL : INSERT Payment(FINAL, COD, PENDING)
    end
    S -> G : createOrder(names, phones, Place(address, ward, district, city), COD, product, qty, price)
    note right of G : addresses are sent by name, no GHN code lookup
    G -> API : POST /shiip/public-api/v2/shipping-order/create
    alt GHN error or unreachable
      API --> G : error
      G --> S : 502 "Lỗi từ GHN: ..." / "GHN đang gặp sự cố (HTTP n)" / "Không thể kết nối tới GHN"
      S --> C : 502, whole transaction rolled back
    else created
      API --> G : order_code
      G --> S : CreateOrderResult(orderCode, totalFee)
      S -> MySQL : INSERT Delivery(GHN, trackingCode, PENDING, ready_to_pick)
      S -> MySQL : UPDATE Order status = DELIVERING
      S --> C : ShipResult(trackingCode)
    end
  end
end
C --> V : { trackingCode }
V --> M : show tracking code

== Refresh delivery status (manual) ==
M -> V : click Refresh
V -> C : POST /{id}/refresh-status
C -> S : refreshStatus(shopId, actor, orderId)
S -> G : track(trackingCode)
G -> API : GET /shipping-order/detail
API --> G : ghn status
G --> S : Tracking(ghnStatus, DeliveryStatus)
S -> DS : apply(order, delivery, tracking, actor)
DS -> DS : save Delivery.ghnStatus and status
alt order is DELIVERING
  DS -> DS : delivered to complete() = COMPLETED and COD payments SUCCESS
  DS -> DS : returned to REFUNDED, cancel to CANCELLED (release voucher)
end
S --> C : DeliveryInfo
C --> V : JSON
V --> M : delivery status

== Push a switch action to GHN (cancel / return / storing) ==
M -> V : choose GHN action
V -> C : POST /{id}/ghn-status { status }
C -> S : pushGhnStatus(shopId, actor, orderId, status)
alt order is not DELIVERING
  S --> C : 400 Chỉ đơn đang giao mới đẩy được trạng thái sang GHN.
else
  S -> G : switchStatus(trackingCode, action)
  G -> API : POST /shiip/public-api/v2/switch-status/{action}
  alt GHN refuses (result false or 400)
    G --> S : 400 "GHN từ chối thao tác: ..."
  else accepted
    S -> G : track(trackingCode)
    S -> DS : apply(order, delivery, tracking, actor)
    S --> C : DeliveryInfo
  end
end

note over M, API
No GHN webhook exists. Status changes only on refresh, on push action,
or when the customer order page asks GHN once on open (refresh-tracking).
end note

@enduml
