@startuml
title 6.3 Unfollow Shop - sequence diagram
autonumber
skinparam shadowing false
skinparam defaultFontName Arial
skinparam wrapWidth 240
skinparam ArrowColor #444444
skinparam sequenceMessageAlign left
skinparam sequence {
  LifeLineBorderColor #888888
  ParticipantBorderColor #444444
  ParticipantBackgroundColor #FFFFFF
}

actor Customer as U
participant "View" as V <<View>> #EADCFF
participant FavoriteShopController as C <<Controller>> #D8F3DC
participant FavoriteShopService as S <<Service>> #DCECFF
participant FavoriteShopRepository as FR <<Repository>> #FFF1C9

== A. Unfollow from the shop page button ==
U -> V : click "♥ Đang theo dõi"
V -> V : button disabled, shows "Đang xử lý..."
V -> C : DELETE /api/customer/favorite-shops/{shopId}
C -> S : remove(userId, shopId)
S -> FR : findById(FavoriteShopId(userId, shopId))
FR --> S : FavoriteShop or empty
opt row exists
  S -> FR : delete(favorite)
end
S --> C : done
C --> V : 204 No Content
V --> U : button "♡ Theo dõi cửa hàng"

== B. Unfollow from the "Cửa hàng đang theo dõi" page ==
U -> V : click "Bỏ theo dõi" on a shop card
note right of V : no confirmation dialog
V -> C : DELETE /api/customer/favorite-shops/{shopId}
C -> S : remove(userId, shopId)
S -> FR : findById(FavoriteShopId(userId, shopId))
FR --> S : FavoriteShop or empty
opt row exists
  S -> FR : delete(favorite)
end
S --> C : done
alt success
  C --> V : 204 No Content
  V -> V : remove the card from the list (no reload)
  V --> U : card disappears
else request failed
  C --> V : error
  V --> U : "Không thể bỏ theo dõi cửa hàng." (role alert), card stays
end

note over S
  The mail queue is not touched: a product mail that is still PENDING
  for this follower is cancelled by the job when it runs (see 6.4 B).
end note

@enduml
