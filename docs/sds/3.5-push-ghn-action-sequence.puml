@startuml
title Push GHN Action (cancel / return / storing) - sequence diagram
autonumber
skinparam shadowing false
skinparam defaultFontName Arial
skinparam wrapWidth 240
skinparam ArrowColor #444444
skinparam sequenceMessageAlign left
skinparam sequence {
  LifeLineBorderColor #888888
  ParticipantBorderColor #444444
  ParticipantBackgroundColor #FFFFFF
}

actor "Shop Manager" as M
participant "View" as V <<View>> #EADCFF
participant ManagerOrderController as C <<Controller>> #D8F3DC
participant ManagerOrderService as S <<Service>> #DCECFF
participant "OrderRepository\nDeliveryRepository" as R <<Repository>> #FFF1C9
participant GhnService as G <<Service>> #DCECFF
participant "GHN API\n(dev-online-gateway.ghn.vn)" as GHN <<External>> #FFE0E0
participant DeliverySync as DS <<Service>> #DCECFF
participant OrderStatusListener as L <<Service>> #DCECFF
database MySQL

== Shop chooses an action ==
M -> V : click "Hủy vận đơn", "Yêu cầu giao lại" or "Yêu cầu trả hàng"
note right of V
  Buttons are shown only for the GHN statuses each action allows
  cancel: ready_to_pick, picking
  storing: storing, waiting_to_return
  return: delivery_fail, storing, waiting_to_return, return
end note
V -> M : confirm dialog "Gửi yêu cầu ... sang GHN?"
alt shop dismisses the dialog
  V --> M : nothing is sent
else shop confirms
  V -> C : POST /api/shop/mine/{shopId}/orders/{id}/ghn-status {status}
  C -> S : pushGhnStatus(shopId, actor, orderId, status)
  S -> S : owned(shopId, actor)
  S -> R : findByIdAndShopId(orderId, shopId)
  alt order not found
    S --> C : 404 Không tìm thấy đơn hàng.
    C --> V : 404 {message}
  else order.status is not DELIVERING
    S --> C : 400 Chỉ đơn đang giao mới đẩy được trạng thái sang GHN.
    C --> V : 400 {message}
  else order.status is DELIVERING
    S -> R : deliveries.findByOrderId(orderId)
    alt no Delivery row
      S --> C : 404 Đơn hàng chưa có vận đơn GHN.
      C --> V : 404 {message}
    else Delivery exists
      S -> G : switchStatus(trackingCode, status)
      alt status not in {cancel, return, storing}
        G --> S : 400 GHN không hỗ trợ thao tác: <status>
        S --> C : 400 {message}
        C --> V : 400 {message}
      else valid action
        G -> GHN : POST /shiip/public-api/v2/switch-status/{action}\nbody order_codes [code], plus reason_code GHN-CANCEL-OTHER for cancel
        alt HTTP 200 and body code 200
          GHN --> G : data = list of per-order results
          alt any result.result is false (return / storing)
            G --> S : 400 GHN từ chối thao tác: <message>
            S --> C : 400 {message}
            C --> V : 400 {message}
          else all results accepted
            G --> S : accepted
            S -> G : track(trackingCode)
            G -> GHN : GET /shiip/public-api/v2/shipping-order/detail?order_code=
            GHN --> G : data.status
            G --> S : Tracking(ghnStatus, DeliveryStatus)
            S -> DS : apply(order, delivery, tracking, actor)
            DS -> DS : update Delivery; change Order only if DELIVERING
            S -> MySQL : UPDATE Deliveries (+ Orders)
            MySQL --> L : @PostUpdate on Order
            S --> C : DeliveryInfo (status read back from GHN)
            C --> V : 200 JSON
            V --> M : log line "GHN trả về: <label>" and list reload
          end
        else GHN HTTP not 200 (e.g. cancel on unknown code), non-JSON, or code not 200
          G --> S : 502 "Lỗi từ GHN: <message>" or "GHN đang gặp sự cố (HTTP n)..."
          S --> C : 502 {message}
          C --> V : 502 {message}
          V --> M : error text and red log line
        else connection failure or timeout
          G --> S : 502 "Không thể kết nối tới GHN ..."
          S --> C : 502 {message}
          C --> V : 502 {message}
          V --> M : error text
        end
      end
    end
  end
end

@enduml
