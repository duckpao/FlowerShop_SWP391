@startuml
title View Order Details - class diagram
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam wrapWidth 240
skinparam ArrowColor #444444
skinparam classAttributeIconSize 0
skinparam nodesep 45
skinparam ranksep 50
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #444444
  BackgroundColor<<View>> #EADCFF
  BackgroundColor<<Controller>> #D8F3DC
  BackgroundColor<<Service>> #DCECFF
  BackgroundColor<<Repository>> #FFF1C9
  BackgroundColor<<Entity>> #E0F3E7
  BackgroundColor<<DTO>> #FCE7F3
  BackgroundColor<<Scheduler>> #FFE8CC
  BackgroundColor<<External>> #FFE0E0
}
hide empty members
hide circle

class View <<View>>

class ManagerOrderController <<Controller>> {
  detail(shopId, id, user)
}
class ManagerOrderService <<Service>> {
  detail(shopId, actor, orderId): OrderDetailResponse
  adminDetail(orderId): OrderDetailResponse
  -buildDetail(order)
  -owned(shopId, actor)
}
class OrderDetailResponse <<DTO>> {
  id
  customerName
  customerPhone
  recipientName
  recipientPhone
  deliveryAddress
  shopAddress
  status
  totalAmount
  note
  shopNote
  cancelReason
}
class OrderItemResponse <<DTO>> {
  productId
  productName
  price
  quantity
}
class DeliveryInfo <<DTO>> {
  trackingCode
  deliveryPartnerId
  status
  ghnStatus
}
class PaymentInfo <<DTO>> {
  id
  method
  status
  amount
}
class OrderRepository <<Repository>>
class OrderDetailRepository <<Repository>> {
  findByOrderId(orderId)
}
class DeliveryRepository <<Repository>> {
  findByOrderId(orderId)
}
class PaymentRepository <<Repository>> {
  findByOrderId(orderId)
}
class AddressRepository <<Repository>> {
  findByShopIdAndUserIsNullOrderByCreatedDateAscIdAsc(shopId)
}
class Order <<Entity>>
class OrderDetail <<Entity>> {
  productName
  price
  quantity
}
class Delivery <<Entity>>
class Payment <<Entity>>
class Address <<Entity>> {
  addressLine
  ward
  district
  city
  isDefault
}
class Product <<Entity>>

View ..> ManagerOrderController : GET /api/shop/mine/{shopId}/orders/{id}
ManagerOrderController --> ManagerOrderService
ManagerOrderService --> OrderRepository
ManagerOrderService --> OrderDetailRepository
ManagerOrderService --> DeliveryRepository
ManagerOrderService --> PaymentRepository
ManagerOrderService --> AddressRepository
ManagerOrderService ..> OrderDetailResponse : builds
OrderDetailResponse *-- OrderItemResponse
OrderDetailResponse *-- DeliveryInfo
OrderDetailResponse *-- PaymentInfo
OrderRepository ..> Order
OrderDetailRepository ..> OrderDetail
DeliveryRepository ..> Delivery
PaymentRepository ..> Payment
OrderDetail "*" --> "1" Order
OrderDetail "*" --> "0..1" Product
Delivery "0..1" --> "1" Order
Payment "*" --> "1" Order
Order "*" --> "0..1" Address : deliveryAddress
AddressRepository ..> Address

@enduml
