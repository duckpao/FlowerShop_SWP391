@startuml
title 3.1 View Order Details (alternative view) - sequence diagram
autonumber
skinparam shadowing false
skinparam defaultFontName Arial
skinparam wrapWidth 240
skinparam ArrowColor #444444
skinparam sequenceMessageAlign left
skinparam sequence {
  LifeLineBorderColor #888888
  ParticipantBorderColor #444444
  ParticipantBackgroundColor #FFFFFF
}

actor "Shop Manager / Staff" as M
participant "View" as V <<View>> #EADCFF
participant ManagerOrderController as C <<Controller>> #D8F3DC
participant ManagerOrderService as S <<Service>> #DCECFF
participant OrderRepository as OR <<Repository>> #FFF1C9
participant OrderDetailRepository as DR <<Repository>> #FFF1C9
participant DeliveryRepository as DL <<Repository>> #FFF1C9
participant PaymentRepository as PR <<Repository>> #FFF1C9
participant AddressRepository as AR <<Repository>> #FFF1C9
database MySQL

M -> V : click an order
V -> C : GET /api/shop/mine/{shopId}/orders/{id}
C -> S : detail(shopId, actor, orderId)
S -> S : owned(shopId, actor)
S -> OR : findByIdAndShopId(orderId, shopId)
OR -> MySQL : SELECT Orders
alt order not found
  S --> C : 404 Không tìm thấy đơn hàng.
else found
  S -> S : buildDetail(order)
  S -> DR : findByOrderId(orderId)
  DR --> S : items (snapshot name, price, quantity)
  S -> DL : findByOrderId(orderId)
  DL --> S : DeliveryInfo (optional, null if no waybill)
  S -> PR : findByOrderId(orderId)
  PR --> S : first PaymentInfo (method, status, amount)
  S -> AR : findByShopIdAndUserIsNullOrderByCreatedDateAscIdAsc(shopId)
  AR --> S : shop addresses, default one used as shopAddress
  S --> C : OrderDetailResponse
end
C --> V : JSON
V --> M : items, recipient, addresses, waybill, payment

@enduml
