@startuml
title Update Order Status - sequence diagram
autonumber
skinparam shadowing false
skinparam defaultFontName Arial
skinparam wrapWidth 240
skinparam ArrowColor #444444
skinparam sequenceMessageAlign left
skinparam sequence {
  LifeLineBorderColor #888888
  ParticipantBorderColor #444444
  ParticipantBackgroundColor #FFFFFF
}

actor "Shop Manager" as M
participant "Manager Order Page" as UI #EADCFF
participant ManagerOrderController as C #D8F3DC
participant ManagerOrderService as S #DCECFF
participant OrderRepository as R #FFF1C9
participant OrderStatusListener as L #DCECFF
participant OrderMailSender as MAIL #DCECFF
database MySQL

== Confirm order ==
M -> UI : click Confirm
UI -> C : POST /api/shop/mine/{shopId}/orders/{id}/confirm
C -> S : confirm(shopId, actor, orderId)
S -> S : owned(shopId, actor)
S -> R : findByIdAndShopId(orderId, shopId)
R --> S : Order
alt status is PENDING
  S -> S : order.status = PROCESSING
  S -> MySQL : UPDATE Orders (transaction commit)
  MySQL --> L : @PostUpdate
  L -> L : compare statusSnapshot with new status
  L --> MAIL : OrderStatusChangedEvent(PENDING to PROCESSING)
  S --> C : 200 OK
else other status
  S --> C : 400 only PENDING can be confirmed
end
C --> UI : result
UI --> M : status PROCESSING

== Change status manually ==
M -> UI : choose target status
UI -> C : POST /{id}/set-status { status }
C -> S : changeStatus(shopId, actor, orderId, target)
S -> R : findByIdAndShopId(orderId, shopId)
alt target equals current, or moves back before shipping when a waybill exists
  S --> C : 400 invalid transition
else valid
  S -> S : sync Delivery.ghnStatus and Delivery.status
  opt target is COMPLETED
    S -> S : mark payments SUCCESS
  end
  S -> S : order.status = target
  S -> MySQL : UPDATE Orders, Deliveries, Payments
  MySQL --> L : @PostUpdate
  L --> MAIL : OrderStatusChangedEvent
  S --> C : StatusResult(status, warning)
end
C --> UI : JSON

@enduml
