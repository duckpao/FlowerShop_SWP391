@startuml
title View Order Details - sequence diagram
autonumber
skinparam shadowing false
skinparam defaultFontName Arial
skinparam wrapWidth 240
skinparam ArrowColor #444444
skinparam sequenceMessageAlign left
skinparam sequence {
  LifeLineBorderColor #888888
  ParticipantBorderColor #444444
  ParticipantBackgroundColor #FFFFFF
}

actor "Shop Manager" as M
participant "Order Detail Dialog" as UI #EADCFF
participant ManagerOrderController as C #D8F3DC
participant ManagerOrderService as S #DCECFF
participant OrderRepository as OR #FFF1C9
participant OrderDetailRepository as DR #FFF1C9
participant DeliveryRepository as DL #FFF1C9
participant PaymentRepository as PR #FFF1C9
participant AddressRepository as AR #FFF1C9
database MySQL

M -> UI : click an order
UI -> C : GET /api/shop/mine/{shopId}/orders/{id}
C -> S : detail(shopId, actor, orderId)
S -> S : owned(shopId, actor)
S -> OR : findByIdAndShopId(orderId, shopId)
OR -> MySQL : SELECT Orders
alt order not found
  S --> C : 404 not found
else found
  S -> S : buildDetail(order)
  S -> DR : findByOrderId(orderId)
  DR --> S : items with product name, price, quantity
  S -> DL : findByOrderId(orderId)
  DL --> S : tracking code, status (optional)
  S -> PR : findByOrderId(orderId)
  PR --> S : payment method, status, amount
  S -> AR : findByShopIdAndUserIsNullOrder...(shopId)
  AR --> S : shop pickup address
  S --> C : OrderDetailResponse
end
C --> UI : JSON
UI --> M : items, recipient, addresses, waybill, payment

@enduml
