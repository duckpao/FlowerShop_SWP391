@startuml
!pragma layout smetana
title 7.8 Best Voucher - class diagram
skinparam shadowing false
skinparam defaultFontName Arial
skinparam wrapWidth 240
skinparam ArrowColor #444444
skinparam classAttributeIconSize 0
skinparam nodesep 45
skinparam ranksep 50
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #444444
  BackgroundColor<<View>> #EADCFF
  BackgroundColor<<Controller>> #D8F3DC
  BackgroundColor<<Service>> #DCECFF
  BackgroundColor<<Repository>> #FFF1C9
  BackgroundColor<<Entity>> #E0F3E7
  BackgroundColor<<External>> #FFE0E0
  BackgroundColor<<DTO>> #ECECEC
  BackgroundColor<<Scheduler>> #FFE8CC
}
hide empty members
hide circle

class View <<View>>

class OrderController <<Controller>> {
  vouchers(userId, request, currentUser): Preview
}
class OrderService <<Service>> {
  previewVouchers(userId, request, merchandiseOnly): Preview
}
class CouponService <<Service>> {
  preview(ctx, orderCode, shippingCode): Preview
  -evaluate(ctx, orderCode, shippingCode, all): Preview
  -saving(c, ctx): BigDecimal
}
class "CouponService.Context" as Context <<DTO>> {
  shopId
  subTotal
  shippingFee
  productTotals
}
class "CouponService.Choice" as Choice <<DTO>> {
  code
  saving
  eligible
  reason
}
class "CouponService.Preview" as Preview <<DTO>> {
  orderVouchers
  shippingVouchers
  recommendedOrderCode
  recommendedShippingCode
  bestSaving
  discountAmount
  shippingDiscountAmount
  totalAmount
}
class CouponRepository <<Repository>> {
  available(shopId): List<Coupon>
}
class Coupon <<Entity>> {
  id
  code
  target
  discountType
  discountValue
  maxDiscountValue
  minOrderValue
  endDate
  shop
}

View --> OrderController : POST /api/orders/{userId}/voucher-preview
OrderController --> OrderService
OrderController ..> Preview : returns
OrderService --> CouponService : preview
CouponService ..> Context : input
CouponService ..> Choice : one per eligible or ineligible coupon
CouponService ..> Preview : returns
Preview *-- "0..*" Choice : orderVouchers, shippingVouchers
CouponService --> CouponRepository
CouponRepository ..> Coupon

note bottom of CouponService
  Suggestion rule (evaluate):
  1. Money vouchers that are eligible and give a saving are sorted by saving.
     bestMoney = the one with the highest saving.
  2. If an eligible shipping voucher exists: combined = best shipping saving + lowest money saving.
     If combined > bestMoney saving, the suggestion is the shipping voucher plus the LOWEST money voucher,
     and bestSaving = combined.
  3. Otherwise the suggestion is bestMoney alone. No eligible voucher: no suggestion, bestSaving = 0.
  The suggestion is not reserved: usedCount changes only when the order is placed (7.6).
end note

note bottom of View
  The checkout box shows "Gợi ý tiết kiệm nhất: CODE1 + CODE2 — giảm X" only when bestSaving > 0.
  "Dùng ưu đãi tốt nhất" fills couponCode and shippingCouponCode from the preview and sends a new preview.
end note

@enduml
