class "GHN API" as GhnApi <<External>>
class Order <<Entity>> {
  id
  orderType: CUSTOM
  status: AWAITING_QUOTE | QUOTED | CANCELLED
  subTotal
  shippingFee
  totalAmount
  shopNote
  cancelReason
}
class OrderDetail <<Entity>> {
  customMaterials: JSON
  price
  quantity
}
class Address <<Entity>> {
  ghnDistrictId
  ghnWardCode
  shop (pickup, user is null)
}
class CustomOrderRequest <<Entity>> {
  id
  status: REQUESTED | NEGOTIATING | ACCEPTED | REJECTED
  desiredComponents: JSON
}
class Shop <<Entity>> {
  id
  status
  owner
}
class ShopStaff <<Entity>> {
  active
}
class "CustomOrderWorkflowService.Quote" as Quote <<DTO>> {
  amount @NotNull @DecimalMin(1) @Digits(10,2)
  note @Size(max 2000)
}
class "CustomFlowerOrderService.Decision" as Decision <<DTO>> {
  status @NotNull
  note @Size(max 2000)
  quotedPrice 1.00..9999999999.99
  depositPercent 10..100
}
class "CustomFlowerOrderService.Result" as Result <<DTO>> {
  id
  status
  design
  orderId
}

