@startuml
title 13.2 Notify Upcoming Occasion via Email - sequence diagram
autonumber
skinparam shadowing false
skinparam defaultFontName Arial
skinparam wrapWidth 240
skinparam ArrowColor #444444
skinparam sequenceMessageAlign left
skinparam sequence {
  LifeLineBorderColor #888888
  ParticipantBorderColor #444444
  ParticipantBackgroundColor #FFFFFF
}

participant "Spring Scheduler" as T <<Scheduler>> #FFE8CC
participant OccasionReminderJob as J <<Scheduler>> #FFE8CC
participant OccasionReminderService as S <<Service>> #DCECFF
participant CustomerOccasionRepository as R <<Repository>> #FFF1C9
participant OccasionSchedule as SC <<Service>> #DCECFF
participant HtmlMailSender as H <<Service>> #DCECFF
participant "SMTP server" as SMTP <<External>> #FFE0E0
participant NotificationService as N <<Service>> #DCECFF
actor Customer
database MySQL

T -> J : run() fixedDelay 15 min (first run after 1 min)
J -> S : sendDueReminders(now)
S -> R : findReminderCandidates(today)
R -> MySQL : SELECT yearly occasions, or future occasions not yet reminded
MySQL --> R : candidates
loop each occasion (an exception on one occasion is logged, loop continues)
  S -> SC : isDue(occasion, now)
  alt not due yet (remindAt not reached, or already reminded for this occurrence)
    SC --> S : false, skip
  else due
    S -> SC : nextOccurrence(occasion, today)
    S -> S : when = "hôm nay", "ngày mai" or "sau N ngày nữa (dd/MM/yyyy)"
    alt customer email present and verified
      S -> H : send(email, "FlowerShop - Sắp đến " + title, html)
      H -> SMTP : send message
      alt mail failed
        H --> S : false
        S -> S : return false, not marked as reminded (retry next scan)
      else mail sent
        SMTP --> Customer : reminder email with product and occasion links
        H --> S : true
      end
    end
    opt mail sent, or customer has no verified email
      S -> N : notifyUser(customer, "Sắp đến dịp: " + title, message, "/shops")
      N -> MySQL : INSERT Notification
      S -> MySQL : set lastRemindedFor; reminderSent = true unless recurringYearly
    end
  end
end
S --> J : number of reminders sent
J -> J : log "Sent N occasion reminder(s)" when N > 0

@enduml
