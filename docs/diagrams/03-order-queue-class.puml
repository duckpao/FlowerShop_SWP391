@startuml
title Order Queue - class diagram
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam wrapWidth 240
skinparam ArrowColor #444444
skinparam classAttributeIconSize 0
skinparam nodesep 45
skinparam ranksep 50
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #444444
  BackgroundColor<<View>> #EADCFF
  BackgroundColor<<Controller>> #D8F3DC
  BackgroundColor<<Service>> #DCECFF
  BackgroundColor<<Repository>> #FFF1C9
  BackgroundColor<<Entity>> #E0F3E7
  BackgroundColor<<DTO>> #FCE7F3
  BackgroundColor<<Scheduler>> #FFE8CC
  BackgroundColor<<External>> #FFE0E0
}
hide empty members
hide circle

class View <<View>>

class ManagerOrderController <<Controller>> {
  queueCount(shopId, user)
  list(shopId, user, page, status)
  queue(shopId, user, page, status)
}
class ManagerOrderService <<Service>> {
  queueCount(shopId, actor): QueueCount
  list(shopId, actor, page, status): Results
  queue(shopId, actor, page, status): Results
  -owned(shopId, actor)
}
class QueueCount <<DTO>> {
  pendingCount
}
class OrderRepository <<Repository>> {
  countByShopIdAndStatusIn(shopId, statuses)
  findByShopIdAndStatus(shopId, status, pageable)
  findByShopIdAndStatusIn(shopId, statuses, pageable)
}
class Order <<Entity>> {
  id
  totalAmount
  status
  createdDate
}
enum OrderStatus <<Entity>> {
  PENDING
  AWAITING_DEPOSIT
  AWAITING_QUOTE
  DEPOSIT_PAID
  PROCESSING
  QUOTED
}

View ..> ManagerOrderController : GET /api/shop/mine/{shopId}/orders/queue/count
View ..> ManagerOrderController : GET /api/shop/mine/{shopId}/orders?page&status
View ..> ManagerOrderController : GET /api/shop/mine/{shopId}/orders/queue
ManagerOrderController --> ManagerOrderService
ManagerOrderService --> OrderRepository
ManagerOrderService ..> QueueCount : returns
OrderRepository ..> Order
Order --> OrderStatus

@enduml
