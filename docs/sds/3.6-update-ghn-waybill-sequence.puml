@startuml
title 3.6 Update GHN Waybill - sequence diagram
autonumber
skinparam shadowing false
skinparam defaultFontName Arial
skinparam wrapWidth 240
skinparam ArrowColor #444444
skinparam sequenceMessageAlign left
skinparam sequence {
  LifeLineBorderColor #888888
  ParticipantBorderColor #444444
  ParticipantBackgroundColor #FFFFFF
}

actor "Shop Manager" as M
participant "View" as V <<View>> #EADCFF
participant ManagerOrderController as C <<Controller>> #D8F3DC
participant ManagerOrderService as S <<Service>> #DCECFF
participant "OrderRepository\nDeliveryRepository" as R <<Repository>> #FFF1C9
participant GhnService as G <<Service>> #DCECFF
participant "GHN API\n(dev-online-gateway.ghn.vn)" as GHN <<External>> #FFE0E0

M -> V : click "Sửa vận đơn GHN" (shown when order is DELIVERING)
V -> M : modal prefilled from orderDetail: to_name, to_phone, weight 2000, note CHOXEMHANGKHONGTHU
M -> V : edit fields, click "Cập nhật GHN"
alt to_phone is empty
  V --> M : notify "Vui lòng nhập số điện thoại người nhận." (no request)
else to_phone filled
  V -> C : POST /api/shop/mine/{shopId}/orders/{id}/update-ghn\n{to_name, to_phone, weight, required_note}
  C -> S : updateGhn(shopId, actor, orderId, body)
  S -> S : owned(shopId, actor)
  S -> R : findByIdAndShopId(orderId, shopId)
  alt order not found
    S --> C : 404 Không tìm thấy đơn hàng.
    C --> V : 404 {message}
  else order found
    S -> R : deliveries.findByOrderId(orderId)
    alt no Delivery row
      S --> C : 404 Đơn hàng chưa có vận đơn GHN để cập nhật.
      C --> V : 404 {message}
    else Delivery exists
      S -> G : updateOrder(trackingCode, body)
      G -> G : body = order_code + the fields sent by the shop
      G -> GHN : POST /shiip/public-api/v2/shipping-order/update
      alt HTTP 200 and body code 200
        GHN --> G : data
        G --> S : void
        note over S
          Only GHN is changed. The local Order recipient
          fields (recipientName, recipientPhone) are NOT updated.
        end note
        S --> C : 200 (empty body)
        C --> V : 200
        V --> M : modal and detail closed, list reloaded, notice "Cập nhật thông tin vận đơn GHN thành công!"
      else GHN HTTP not 200, non-JSON, or code not 200
        G --> S : 502 "Lỗi từ GHN: <message>" or "GHN đang gặp sự cố (HTTP n)..."
        S --> C : 502 {message} (nothing written)
        C --> V : 502 {message}
        V --> M : red banner with the GHN message (setError), modal stays open
      else connection failure or timeout
        G --> S : 502 "Không thể kết nối tới GHN ..."
        S --> C : 502 {message}
        C --> V : 502 {message}
        V --> M : red banner with the GHN message
      end
    end
  end
end

@enduml
