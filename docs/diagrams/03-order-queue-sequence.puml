@startuml
title Order Queue - sequence diagram
autonumber
skinparam shadowing false
skinparam defaultFontName Arial
skinparam wrapWidth 240
skinparam ArrowColor #444444
skinparam sequenceMessageAlign left
skinparam sequence {
  LifeLineBorderColor #888888
  ParticipantBorderColor #444444
  ParticipantBackgroundColor #FFFFFF
}

actor "Shop Manager" as M
participant "Manager Dashboard" as UI #EADCFF
participant ManagerOrderController as C #D8F3DC
participant ManagerOrderService as S #DCECFF
participant OrderRepository as R #FFF1C9
database MySQL

M -> UI : open shop dashboard
UI -> C : GET /api/shop/mine/{shopId}/orders/queue/count
C -> S : queueCount(shopId, actor)
S -> S : owned(shopId, actor)
S -> R : countByShopIdAndStatusIn(shopId, [PENDING, AWAITING_DEPOSIT])
R -> MySQL : SELECT COUNT(*) FROM Orders
MySQL --> R : n
S --> C : QueueCount(n)
C --> UI : { pendingCount: n }
UI --> M : badge with waiting orders

M -> UI : open queue list
UI -> C : GET /orders?status=PENDING&page=0
C -> S : list(shopId, actor, 0, "PENDING")
S -> R : findByShopIdAndStatus(shopId, PENDING, pageable)
R -> MySQL : SELECT Orders newest first
MySQL --> R : page
S --> C : Results
C --> UI : JSON
UI --> M : queue of orders waiting for confirmation

@enduml
