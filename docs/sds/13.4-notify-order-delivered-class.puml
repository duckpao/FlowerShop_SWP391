@startuml
title 13.4 Notify Order Delivered via Email - class diagram
!pragma layout smetana
skinparam shadowing false
skinparam defaultFontName Arial
skinparam wrapWidth 240
skinparam ArrowColor #444444
skinparam classAttributeIconSize 0
skinparam nodesep 45
skinparam ranksep 50
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #444444
  BackgroundColor<<View>> #EADCFF
  BackgroundColor<<Controller>> #D8F3DC
  BackgroundColor<<Service>> #DCECFF
  BackgroundColor<<Repository>> #FFF1C9
  BackgroundColor<<Entity>> #E0F3E7
  BackgroundColor<<DTO>> #FCE7F3
  BackgroundColor<<Scheduler>> #FFE8CC
  BackgroundColor<<External>> #FFE0E0
}
hide empty members
hide circle

class View <<View>>

class ManagerOrderController <<Controller>> {
  refreshStatus(shopId, id, user)
  setStatus(shopId, id, user, body)
}
class CustomerOrderController <<Controller>> {
  refreshTracking(user, id)
}
class ManagerOrderService <<Service>> {
  refreshStatus(shopId, actor, orderId)
  changeStatus(shopId, actor, orderId, target)
}
class CustomerOrderService <<Service>> {
  refreshTracking(customerId, orderId)
}
class DeliverySync <<Service>> {
  apply(order, delivery, tracking, actor)
  complete(order, actor)
}
class GhnService <<Service>> {
  track(orderCode): Tracking
}
class OrderStatusListener <<Service>> {
  remember(order) @PostLoad
  publishIfChanged(order) @PostUpdate
}
class OrderStatusChangedEvent <<Service>> {
  orderId
  from
  to
}
class OrderMailSender <<Service>> {
  onStatusChanged(event) @Async AFTER_COMMIT
  -buildStatusMail(event)
  -placesSection(order)
  -reviewSection(order)
}
class HtmlMailSender <<Service>> {
  send(to, subject, html): boolean
  url(path)
  layout(heading, bodyHtml, buttonLabel, buttonUrl)
}
class OrderRepository <<Repository>>
class DeliveryRepository <<Repository>>
interface ProductReviewRepository <<Repository>>
class Order <<Entity>> {
  status
  statusSnapshot
}
class Delivery <<Entity>> {
  trackingCode
  ghnStatus
}
class User <<Entity>> {
  email
  fullName
  isEmailVerified
}
class "SMTP server" as SMTP <<External>>

View ..> ManagerOrderController : POST /api/shop/mine/{shopId}/orders/{id}/refresh-status
View ..> ManagerOrderController : POST /api/shop/mine/{shopId}/orders/{id}/set-status
View ..> CustomerOrderController : POST /api/customer/orders/{id}/refresh-tracking
ManagerOrderController --> ManagerOrderService
CustomerOrderController --> CustomerOrderService
ManagerOrderService --> GhnService
ManagerOrderService --> DeliverySync
CustomerOrderService --> GhnService
CustomerOrderService --> DeliverySync
DeliverySync --> Order : status COMPLETED, COD payments SUCCESS
Order ..> OrderStatusListener : @EntityListeners
OrderStatusListener ..> OrderStatusChangedEvent : publishes
OrderMailSender ..> OrderStatusChangedEvent : listens AFTER_COMMIT
OrderMailSender --> OrderRepository
OrderMailSender --> DeliveryRepository
OrderMailSender --> ProductReviewRepository
OrderMailSender --> HtmlMailSender
HtmlMailSender --> SMTP
Order "*" --> "1" User : customer
Delivery "0..1" --> "1" Order

@enduml
