@startuml
title 8.2 Create Pro Plan - sequence diagram
autonumber
skinparam shadowing false
skinparam defaultFontName Arial
skinparam wrapWidth 240
skinparam ArrowColor #444444
skinparam sequenceMessageAlign left
skinparam sequence {
  LifeLineBorderColor #888888
  ParticipantBorderColor #444444
  ParticipantBackgroundColor #FFFFFF
}

actor Admin as U
participant "View" as V <<View>> #EADCFF
participant AdminShopPlanController as C <<Controller>> #D8F3DC
participant ShopPlanService as S <<Service>> #DCECFF
participant UserRepository as UR <<Repository>> #FFF1C9
participant ShopPlanRepository as PR <<Repository>> #FFF1C9

== A. Create a plan ==
U -> V : fill the form (defaults: 15 products, 3 featured, 59 000 VND) and click "Lưu"
V -> V : empty product limit is sent as null (unlimited)
V -> C : POST /api/admin/shop-plans\n(name, durationMonths, price, productLimit | null, featuredLimit, enabled)
C -> C : @PreAuthorize hasRole('ADMIN'), @Valid PlanInput
alt bean validation fails
  C --> V : 400 "Dữ liệu không hợp lệ" + field errors
else valid
  C -> S : savePlan(adminId, null, input)
  S -> UR : findByIdAndRoleAndStatus(adminId, ADMIN, ACTIVE)
  UR --> S : User or empty
  alt not an active admin
    S --> C : 403 "Chỉ admin đang hoạt động được kích hoạt Pro."
  else admin
    alt productLimit not null and featuredLimit > productLimit
      S --> C : 409 "Số sản phẩm nổi bật không được vượt giới hạn sản phẩm."
    else valid limits
      S -> S : new id "PRO" + 17 hex chars, name stripped
      S -> PR : saveAndFlush(ShopPlan)
      PR --> S : saved plan
      S --> C : Plan
      C --> V : 200 OK
      V --> U : "Đã lưu cấu hình gói." and the list reloads
    end
  end
end

note over S
  Only the plan row is created. Shops see it on the next plan list call (8.1).
end note

@enduml
